  "cards": [
    {
      "dot": "rose",
      "title": "Nothing flows without authorization",
      "items": [
        "Course access and grading never depend on research participation",
        "Consent and ethics/data review gate every source before it counts as data",
        "Today: pre-protocol — no source has been authorized yet"
      ]
    },
    {
      "dot": "cyan",
      "title": "Distinct identities, distinct access",
      "items": [
        "Teaching repository and any research dataset never share a store",
        "Minimization, retention, pseudonymization, withdrawal — settled first",
        "Reviewer access is defined before any collection begins"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two evidence forms per claim",
      "items": [
        "Never infer understanding from repository activity alone",
        "Triangulate product behavior, versioned record, and oral defence",
        "Negative or mixed findings are valid outcomes, not noise"
      ]
    }
  ]
