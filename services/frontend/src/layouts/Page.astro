---
interface Props { lang: 'en' | 'es'; title: string }
const { lang, title } = Astro.props;
import '../styles/tokens.css';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#fbf8f1" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/visual-system/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/visual-system/tokens.css" />
    <link rel="stylesheet" href="/visual-system/backgrounds.css" />
    <title>{title}</title>
    <style>
      :root { color-scheme: light; font-family: var(--ttod-font-body); }
      body { max-width: 48rem; margin: 0 auto; padding: 4rem 1.5rem; color: var(--ttod-color-ink); background-color: var(--ttod-color-paper); line-height: 1.6; }
      nav { display: flex; gap: 1rem; font-family: ui-sans-serif, system-ui, sans-serif; }
      article { border-inline-start: .25rem solid var(--ttod-color-accent); margin-block: 2rem; padding-inline: 1.5rem; }
      .meta { font-family: ui-sans-serif, system-ui, sans-serif; font-size: .9rem; opacity: .8; }
      .ttod-network-boundary {
        position: sticky;
        top: 0;
        z-index: 20;
        margin: 0 0 1.5rem;
        padding: 0.5rem 0.75rem;
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.9rem;
        border: 1px solid var(--ttod-color-line, #8f8068);
        background: var(--ttod-color-surface, #f1eadb);
      }
      .ttod-network-boundary[data-state="offline"] {
        background: #211c15;
        color: #fbf8f1;
        border-color: #211c15;
      }
    </style>
  </head>
  <body class="ttod-bg-river">
    <p id="ttod-network-boundary" class="ttod-network-boundary" role="status" aria-live="polite">
      Network: checking…
    </p>
    <slot />
    <script is:inline>
      (function registerServiceWorkerStub() {
        if (!('serviceWorker' in navigator)) {
          return;
        }
        navigator.serviceWorker.register('/sw.js').catch(function (error) {
          console.warn('[ttod-sw] registration failed', error);
        });
      })();
      (function observeNetworkBoundary() {
        var banner = document.getElementById('ttod-network-boundary');
        if (!banner) {
          return;
        }
        function renderNetworkBoundary() {
          var online = navigator.onLine;
          banner.dataset.state = online ? 'online' : 'offline';
          banner.textContent = online
            ? 'Network: online — hello-world stub; toggle DevTools Network → Offline to see this change.'
            : 'Network: offline — local/offline boundary is visible. This stub does not serve the whole app from cache.';
        }
        renderNetworkBoundary();
        window.addEventListener('online', renderNetworkBoundary);
        window.addEventListener('offline', renderNetworkBoundary);
      })();
    </script>
  </body>
</html>
