{
  "$comment": "LOCATORS.md §4 as data (Phase AA3b). The Vitest registry test (src/tests/locators-registry.test.ts) and the AA3b exit gate's live probe both walk this file. A locator that is not here is not a contract: add it here first. Placeholders: {l} locale; {section} every corpus section of that locale (in ids) or values.section (in paths); {level} {tag} {word} from values; {quote} in ids = at least one corpus id of the locale, in paths = a concrete corpus id; {a} {b} two corpus ids; {other-quote} an id that only exists in the other locale. \"index\": false (AA4) keeps a page out of search engines on any host (robots noindex, no canonical, no hreflang); \"auth\": true implies it. Canonical and hreflang rules read this file (src/lib/seo.ts).",
  "values": {
    "section": "architecture",
    "level": "advanced",
    "tag": "koan",
    "word": { "en": "simplicity", "es": "diseno" },
    "search": { "en": ["debt", "SIMPLICITY", "arch-008"], "es": ["diseno", "DISEÑO", "Diseño", "koan", "arch-060"] }
  },
  "pages": [
    { "path": "/{l}/", "ids": ["start", "doors", "thesis", "map", "map-{section}", "close", "flagship-quote-heading", "sigue-tesis", "sigue-rollo"] },
    { "path": "/{l}/wisdom/", "ids": ["search", "draw", "facets", "volume-{section}"] },
    { "path": "/{l}/wisdom/?q={word}", "ids": ["search", "draw", "facets", "{quote}"] },
    { "path": "/{l}/wisdom/?section={section}&level={level}", "ids": ["search", "{quote}"] },
    { "path": "/{l}/wisdom/{quote}/", "ids": [], "conditional": ["related-wisdom-title"], "$comment": "conditional: rendered only when the quote has related entries; the es corpus has none today, so en/es parity ignores it" },
    { "path": "/{l}/wisdom/sections/{section}/", "ids": ["{quote}"] },
    { "path": "/{l}/wisdom/levels/{level}/", "ids": ["{quote}"] },
    { "path": "/{l}/wisdom/tags/{tag}/", "ids": ["{quote}"] },
    { "path": "/{l}/graph/", "ids": [] },
    { "path": "/{l}/graph/plano/", "ids": [] },
    { "path": "/{l}/graph/code/", "ids": [] },
    { "path": "/{l}/oracle/", "ids": [] },
    { "path": "/{l}/docs/", "ids": [] },
    { "path": "/{l}/login/", "ids": [] },
    { "path": "/{l}/register/", "ids": [] },
    { "path": "/{l}/wisdom/propose/", "ids": [], "index": false, "$comment": "AA4: a form behind sign-in; anonymous visitors only see a prompt" },
    { "path": "/{l}/quote/", "ids": [], "index": false, "$comment": "AA4: a different random quote on every visit; its stable address is the quote's own page" },
    { "path": "/{l}/library/", "ids": ["{quote}"], "auth": true },
    { "path": "/{l}/account/", "ids": ["profile", "password", "sessions"], "auth": true },
    { "path": "/{l}/account/reviewer/", "ids": [], "auth": true }
  ],
  "redirects": [
    { "from": "/{l}/wisdom", "to": "/{l}/wisdom/" },
    { "from": "/{l}/graph", "to": "/{l}/graph/" },
    { "from": "/{l}/oracle?x=1", "to": "/{l}/oracle/?x=1" },
    { "from": "/{l}/graph/path", "to": "/{l}/graph/" },
    { "from": "/{l}/graph/path/?from={a}&to={b}", "to": "/{l}/graph/?from={a}&to={b}" },
    { "from": "/{l}/graph/path?from={a}&to={b}", "to": "/{l}/graph/?from={a}&to={b}" },
    { "from": "/{l}/graph/path?s=services/backend/app/main.py", "to": "/{l}/graph/code/?s=services/backend/app/main.py" },
    { "from": "/{l}/graph/?tag={tag}", "to": "/{l}/graph/plano/?tag={tag}" },
    { "from": "/{l}/wisdom/?section={section}", "to": "/{l}/wisdom/sections/{section}/" },
    { "from": "/{l}/wisdom/?level={level}&orden=nivel", "to": "/{l}/wisdom/levels/{level}/?orden=nivel" },
    { "from": "/{l}/wisdom/?tag={tag}", "to": "/{l}/wisdom/tags/{tag}/" }
  ],
  "notFound": ["/{l}/wisdom/zz-999/", "/{l}/wisdom/{other-quote}/", "/{l}/wisdom/sections/zz-none/", "/{l}/wisdom/tags/zz-none/"],
  "exempt": ["/{l}/logout", "/api/v1/graph", "/visual-system/tokens.css", "/sw.js", "/site.webmanifest"],
  "queryKeys": {
    "new": ["q", "section", "level", "tag", "from", "to", "untranslated"],
    "shipped": ["orden", "p", "s", "tag", "node"]
  },
  "fragments": {
    "landing": ["start", "doors", "thesis", "map", "map-{section}", "close"],
    "wisdom": ["{quote}", "volume-{section}", "search", "draw", "facets"],
    "account": ["profile", "password", "sessions"]
  }
}
