---
import Page from '../../layouts/Page.astro';
import type { WisdomEntry } from '../../types/domain';

const backend = import.meta.env.BACKEND_URL ?? 'http://backend:8000';
const response = await fetch(`${backend}/api/v1/wisdom/sample`, {
  headers: { accept: 'application/json' }
});
if (!response.ok) throw new Error(`Backend flagship quote request failed (${response.status})`);
const entries: WisdomEntry[] = await response.json();
const flagship = entries.find((entry) => entry.id === 'wis-033');
if (!flagship) throw new Error('Governed flagship quote wis-033 is unavailable');
---
<Page lang="en" title="道 The Tao of Development (TTOD)">
  <nav><a href="/en/">English</a><a href="/es/">Español</a></nav>
  <main>
    <h1>Welcome to 道 The Tao of Development (TTOD)</h1>
    <p>A living collection of pedagogical wisdom for developers walking the path.</p>
    <article class="ttod-bg-constellation" aria-labelledby="flagship-quote-heading">
      <h2 id="flagship-quote-heading">Flagship quote</h2>
      <blockquote>{flagship.text}</blockquote>
      <p>{flagship.id} · {flagship.section} · {flagship.lang}</p>
    </article>
    <p><a href="/en/quote">Read a live quote</a></p>
  </main>
</Page>
