---
import Page from '../../../../layouts/Page.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { fetchWisdom, isLocale, labels } from '../../../../content/wisdom';
import '../../../../styles/tokens.css';
const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });
const entries = (await fetchWisdom(locale)).filter((entry) => entry.level === Astro.params.level);
const copy = labels[locale];
---
<Page lang={locale} title={`${copy.levels}: ${Astro.params.level}`}>
  <main class="ttod-shell">
    <Breadcrumbs locale={locale} items={[{ label: copy.wisdom, href: `/${locale}/wisdom/` }, { label: Astro.params.level ?? '' }]} />
    <h1>{copy.levels}: {Astro.params.level}</h1>
    {entries.length === 0 ? <p class="ttod-empty">{copy.empty}</p> : <div class="ttod-grid">{entries.map((entry) => <article class="ttod-card"><blockquote>{entry.text}</blockquote><a href={`/${locale}/wisdom/${entry.id}/`}>{entry.id}</a><footer class="ttod-meta">{entry.rights.holder ?? 'Rubén Vega Balbás'} · {entry.rights.license}</footer></article>)}</div>}
  </main>
</Page>
