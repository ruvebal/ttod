{
  # F2 (AA5): this Caddy serves **plain HTTP** on both ports. :8443 is NOT TLS; it is a second
  # HTTP port kept for old bookmarks. HTTPS, when there is one, ends at a proxy in front
  # (Traefik on Lilith). Never describe this file as "HTTPS".
  auto_https off
  servers {
    # Only a proxy listed here may pass X-Forwarded-Proto / -For through; from anyone else Caddy
    # replaces them, so a student cannot fake https or dodge the per-IP throttles (AA2).
    # TTOD_TRUSTED_PROXIES = the address(es) or CIDR(s) of the TLS proxy in front, separated by
    # SPACES (a comma stops Caddy from starting). The default trusts nobody: nothing reaches Caddy from
    # its own loopback. Never the classroom LAN, never `private_ranges`, and on Docker Desktop never
    # the host gateway (192.168.65.x): every LAN client arrives from it (cold review AA5, F2).
    trusted_proxies static {$TTOD_TRUSTED_PROXIES:127.0.0.1/32}
  }
}

(seguridad) {
  # Cabeceras de seguridad (F1 / AA1). Se aplican a toda respuesta: las del sitio con
  # `import seguridad`, y los errores que genera el propio Caddy (502, 404 de file_server)
  # con `handle_errors`, porque esos se saltarían el bloque del sitio.
  # - X-Frame-Options: nadie enmarca TTOD (no hay iframes propios), así que DENY. La CSP va en
  #   report-only, y en ese modo `frame-ancestors` no protege; por eso la denegación de marcos
  #   la da esta cabecera.
  # - Permissions-Policy: la app no usa cámara, micrófono, geolocalización ni pagos.
  # - CSP en report-only: es la política objetivo (scripts solo de 'self', sin inline). El
  #   navegador informa en consola de lo que rompería; esa lista es el trabajo previo a
  #   imponerla (hashes de los scripts inline de Astro). Los estilos conservan 'unsafe-inline'
  #   por los atributos style= del sistema visual. img-src admite blob: por las texturas
  #   generadas en el navegador (estilo/cielo.ts, lib/tinta.ts).
  # - Sin HSTS: el borde es HTTP plano (F2, AA5); anunciar HTTPS aquí sería mentir.
  header {
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    X-Content-Type-Options "nosniff"
    Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'report-sample'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    -Server
  }
}

:8080, :8443 {
  import seguridad
  # AA5 (cold review F4): @astrojs/node can crash on a malformed port in the Host header (an npm
  # advisory still open until the Astro major upgrade). Only a hostname or IP, with an optional numeric
  # port, gets past Caddy.
  # The Host header is not in Go's header map, so match Caddy's host:port placeholder instead.
  @hostmalo not vars_regexp {http.request.hostport} ^([A-Za-z0-9.-]+|\[[0-9A-Fa-f:]+\])(:[0-9]{1,5})?$
  # A `handle` and the first one: Caddy runs `respond` after `handle`, so a bare respond never fired.
  handle @hostmalo {
    respond "Bad Request" 400
  }

  @api path /api/* /health
  handle @api {
    # El JSON de la API también se comprime (medido en la vista previa con gzip:
    # /api/v1/graph 138 KB -> 15 KB, /api/v1/wisdom/sample 230 KB -> 51 KB). Solo
    # JSON: el oráculo contesta en `text/event-stream` y ese flujo no pasa por el
    # compresor, que lo retendría hasta llenar un bloque y rompería el goteo.
    encode {
      zstd
      gzip
      match {
        header Content-Type application/json*
      }
    }
    # El corpus público cambia a mano y pocas veces: un minuto en el navegador (o
    # en un CDN, si algún día lo hay), igual que la copia que guarda el servidor
    # de Astro. `?` solo lo pone si el backend no manda ya su propia cabecera.
    @corpus {
      method GET
      path /api/v1/wisdom/sample
    }
    header @corpus ?Cache-Control "public, max-age=60, stale-while-revalidate=600"
    # F48: every API request carries Caddy's own id; the backend logs it and returns it.
    # Set here, so a client-supplied X-Request-ID never reaches the logs.
    reverse_proxy backend:8000 {
      header_up X-Request-ID {http.request.uuid}
    }
  }

  @serviceWorker path /sw.js
  header @serviceWorker Cache-Control "max-age=0, no-cache"

  # El adaptador de Node sólo marca `/_astro/*` como inmutable; todo lo que vive
  # en `public/` sale con `max-age=0`, así que el navegador revalida en cada
  # navegación. Medido a 390 con 4G lento: los seis woff2 (~145 KB) se
  # revalidaban al pasar de una vista a otra, y `difusion-tinta.webp` llegaba a
  # bajarse dos veces en la misma carga (322 + 321 KB).
  # Las fuentes llevan nombre estable y no cambian: un año.
  @fuentes path /visual-system/fonts/*
  header @fuentes Cache-Control "public, max-age=31536000, immutable"
  # Las pinturas comparten nombre entre versiones (`valle-frente-3136.webp` se
  # regradúa sin renombrarse), así que una semana, no un año: quien ya la tiene
  # no la vuelve a pedir hoy, y una gradación nueva llega como mucho en siete
  # días. Cuando los nombres lleven versión, esto sube a `immutable`.
  @pinturas {
    path /visual-system/*
    not path /visual-system/fonts/*
  }
  header @pinturas Cache-Control "public, max-age=604800"

  # Static build of docs/public (project info, teaching model, backlog) — `make docs-local`
  # populates this; empty/missing until then. Instructor reference only, not the student artifact.
  handle_path /project-docs/* {
    root * /srv/project-docs
    file_server
  }

  handle {
    encode zstd gzip
    reverse_proxy frontend:4321
  }

  # Errores generados por Caddy (no los del upstream): misma política de cabeceras.
  handle_errors {
    import seguridad
    respond "{err.status_code} {err.status_text}" {err.status_code}
  }
}
