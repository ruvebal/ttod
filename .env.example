# No se necesitan credenciales para arrancar; el login de administrador queda deshabilitado
# hasta que se configure un hash de contraseña.
COMPOSE_PROJECT_NAME=ttod_oracle
HTTP_PORT=8080
ALT_HTTP_PORT=8443

# The app runs its own Ollama container by default — nothing to install, `make up`
# just works. This is the one supported, documented path (what students use).
OLLAMA_MODE=container
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CONTAINER_PORT=11435

# Advanced, personal override — not a `make` target, not diagrammed: point the app at
# an Ollama you already run yourself (e.g. for GPU speed outside Docker on macOS,
# where Docker has no Metal passthrough). Uncomment and adjust if you want this:
# OLLAMA_MODE=host
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=<your own already-pulled model>

# Advanced service paths/policy. These defaults match the container images.
TTOD_PATH=/workspace/ttod.yml
TTOD_SCHEMA_DIR=/workspace/schema
TTOD_PROPOSAL_DIR=/workspace/services/backend/data/proposals
# Carpeta del host montada en TTOD_PROPOSAL_DIR (F25). TTOD_PROPOSAL_DIR debe ser una ruta absoluta.
TTOD_PROPOSAL_HOST_DIR=./data/proposals
# Obligatorio con REDIS_URL: si está vacío, el backend no arranca (F28). Sin Redis (dev) se genera uno temporal.
# Preferible: `make env-secrets` (también lo llama `make up`) deja valores estables
# en .env sin pisar los que ya tengas. A mano: secrets.token_urlsafe(32)
TTOD_SESSION_SECRET=
TTOD_SESSION_TTL_SECONDS=3600
# Secreto del token de la API pública (PAT). Debe ser distinto del de la sesión web.
TTOD_PAT_SECRET=
TTOD_PAT_TTL_SECONDS=3600
TTOD_ADMIN_EMAIL=admin@ttod.local
TTOD_ADMIN_PASSWORD_HASH=
# `make env-secrets` rellena el hash (con `$` escapado como `$$` para Compose) y
# escribe la contraseña una vez en .env.admin-password (gitignored). A mano:
# python -c "from getpass import getpass; from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash(getpass()).replace('$','$$'))"
ORACLE_RETRIEVAL_THRESHOLD=0.575
ORACLE_RETRIEVAL_TOP_K=5
# Shore Redis (Compose service). Stores users/sessions/favorites/proposal drafts —
# never the governed ttod.yml corpus. Leave as-is for make up; empty REDIS_URL in
# local non-Compose runs falls back to in-memory / filesystem test backends.
REDIS_URL=redis://redis:6379/0

# Optional, personal, IDE-only — NOT required to run the app (line 1 still holds for the
# stack itself). Only needed if you individually opt into the GitHub MCP server documented
# at agentic/ide-mcp/examples/github.json; leave unset otherwise. Never commit a real value —
# this file only ever holds the variable name. See AGENTIC-HARNESS.md "GitHub MCP: opt-in
# only" for why this server is never in the committed .cursor/mcp.json default.
# If this PAT (or your separate `gh auth` token) must create/update .github/workflows/*,
# it also needs the OAuth `workflow` scope — see agentic/ide-mcp/README.md.
# GITHUB_PERSONAL_ACCESS_TOKEN=
