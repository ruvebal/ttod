---
import Page from '../../../../layouts/Page.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Bosque from '../../../../components/wisdom/Bosque.astro';
import { isLocale, labels, loadWisdom } from '../../../../content/wisdom';
import { copia, rotuloSeccion, pasilloPedido } from '../../../../content/bosque';
import '../../../../styles/tokens.css';
import '../../../../styles/bosque.css';
const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });
const section = Astro.params.section ?? '';
const { entries: all, failed } = await loadWisdom(locale);
const entries = all.filter((entry) => entry.section === section);
// Un valor que el corpus de este idioma no tiene no es una lista vacía, es un recurso
// que no existe: 404, como una cita desconocida (cold review AA3b, F10). La página
// sigue diciendo «sin coincidencias» y ofreciendo la vuelta.
if (!failed && entries.length === 0) Astro.response.status = 404;
const copy = labels[locale];
const t = copia[locale];
const rotulo = rotuloSeccion(section, locale);
---
<Page
  lang={locale}
  title={`${copy.sections}: ${rotulo}`}
  pagina={pasilloPedido(Astro.url.searchParams.get('p'), entries.length)}
  indexar={!failed}
>
  <main id="ttod-main" class="bosque">
    <Breadcrumbs locale={locale} items={[{ label: copy.wisdom, href: `/${locale}/wisdom/` }, { label: rotulo }]} />
    <Bosque
      locale={locale}
      todas={all}
      entries={entries}
      failed={failed}
      activa={{ tipo: 'sections', valor: section }}
      titulo={t.tituloFaceta(rotulo)}
      intro={t.introFaceta(rotulo, all.length)}
    />
  </main>
</Page>
