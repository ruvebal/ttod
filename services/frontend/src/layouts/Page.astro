---
interface Props { lang: 'en' | 'es'; title: string }
const { lang, title } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <style>
      :root { color-scheme: light dark; font-family: ui-serif, Georgia, serif; }
      body { max-width: 48rem; margin: 0 auto; padding: 4rem 1.5rem; line-height: 1.6; }
      nav { display: flex; gap: 1rem; font-family: ui-sans-serif, system-ui, sans-serif; }
      article { border-inline-start: .25rem solid #9c7a31; margin-block: 2rem; padding-inline: 1.5rem; }
      .meta { font-family: ui-sans-serif, system-ui, sans-serif; font-size: .9rem; opacity: .8; }
    </style>
  </head>
  <body><slot /></body>
</html>
