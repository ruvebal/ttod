  "cards": [
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Agents and Oracle may stage proposals; they never own quote IDs",
        "Canonical writes require human review (blackbox → validated_by human)",
        "MCP and exports are rights-gated public surfaces"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ownership & licenses",
      "items": [
        "TTOD owns ttod.yml identity & CLI mutations",
        "Code MIT · content CC BY-NC-SA 4.0 — pedagogical, not Athanor/WPL evidence",
        "Deprecate; never delete. Cite by accepted ID only"
      ]
    },
    {
      "dot": "cyan",
      "title": "Whose Ollama is it?",
      "items": [
        "make up: the app owns its Ollama — a dedicated container, nothing to install, the supported default",
        "Yours (manual, personal): borrow an Ollama you already run — e.g. Metal GPU speed outside Docker on macOS",
        "Same Oracle/MCP code either way — only OLLAMA_BASE_URL changes; still no cloud LLM"
      ]
    }
