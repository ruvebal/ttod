# Local configuration only; no credentials are required.
OLLAMA_MODE=host
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://host.containers.internal:11434
MCP_SERVER_URL=http://mcp:3001
ORACLE_RETRIEVAL_THRESHOLD=0.575
ORACLE_RETRIEVAL_TOP_K=5
TTOD_PATH=/workspace/ttod.yml
TTOD_SCHEMA_DIR=/workspace/schema
TTOD_PROPOSAL_DIR=/workspace/services/backend/data/proposals

# Teaching-only identity (TS4c). Never a real reused password. Session secret and PAT
# secret MUST differ — the cookie and the bearer token are separate credentials.
TTOD_SESSION_SECRET=dev-insecure-session-secret-not-for-production
TTOD_PAT_SECRET=dev-insecure-pat-secret-not-for-production
TTOD_SESSION_COOKIE_NAME=ttod_session
TTOD_SEED_USER_EMAIL=student@ttod.local
TTOD_SEED_USER_PASSWORD=ttod-teaching-only-not-a-real-password
TTOD_SEED_USER_DISPLAY_NAME=Cohort Student
TTOD_SEED_USER_ROLE=student
TTOD_SEED_USER_ID=user-seed-student
