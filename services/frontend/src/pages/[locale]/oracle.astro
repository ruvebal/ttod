---
import OracleTerminal from '../../components/oracle/OracleTerminal';
import Page from '../../layouts/Page.astro';

const locale = Astro.params.locale;
if (locale !== 'en' && locale !== 'es') return new Response(null, { status: 404 });
const title = locale === 'es' ? 'Oráculo · 道 El Tao del Desarrollo (TTOD)' : 'Oracle · 道 The Tao of Development (TTOD)';
const home = locale === 'es' ? 'Inicio' : 'Home';
---
<Page lang={locale} title={title}>
  <nav><a href={`/${locale}/`}>{home}</a></nav>
  <main>
    <OracleTerminal locale={locale} client:load />
  </main>
</Page>
