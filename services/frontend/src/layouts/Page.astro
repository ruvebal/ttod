---
interface Props {
  lang: 'en' | 'es'; title: string; description?: string;
  /** Fuentes que solo usa esta vista y conviene pedir ya (nombre del woff2 en /visual-system/fonts). */
  fuentesExtra?: string[];
  /** Adónde lleva el cambio de idioma si no es la misma ruta en la otra lengua (una cita va a su gemela). */
  cambioIdioma?: string;
  /**
   * Quien está dentro, si la página ya lo sabe (se ahorra otra pregunta al backend).
   * Sin pasarlo, el layout lo pregunta solo cuando hay cookie de sesión.
   */
  usuario?: AuthUser | null;
  /**
   * La gemela en la otra lengua para `hreflang` (AA4). Sin pasarlo, la misma ruta en la otra
   * lengua; `null` cuando no la hay (una cita sin traducción) y entonces no se anuncia ninguna.
   */
  alterna?: string | null;
  /** `false` deja la página fuera de los buscadores aunque su fila del registro no lo diga. */
  indexar?: boolean;
  /** `og:type`: una cita es un artículo; el resto, el sitio. */
  tipo?: 'website' | 'article';
}
const { lang, title, description, fuentesExtra = [], cambioIdioma, alterna, indexar, tipo = 'website' } = Astro.props;
import '../styles/tokens.css';
import Footer from '../components/Footer.astro';
import { getSessionUser } from '../lib/auth.server';
import { enlaceEntrar, esActual } from '../lib/enlaces-cuenta';
import { alternas, canonica, indexable, origenPublico } from '../lib/seo';
import type { AuthUser } from '../types/domain';

// La cabecera sabe si hay sesión (F7): «Entrar» o «Cuenta», y «Biblioteca» solo
// para quien la tiene (F10). Sin cookie no se pregunta nada al backend.
const usuario = Astro.props.usuario !== undefined ? Astro.props.usuario : await getSessionUser(Astro.request);

const nav = {
  en: {
    home: 'Home', wisdom: 'Wisdom', library: 'Library', graph: 'Graph', oracle: 'Oracle', docs: 'Docs',
    signIn: 'Sign in', account: 'Account', main: 'Main navigation', utility: 'Your account and language',
    skip: 'Skip to content', switchTo: 'Español',
    menu: 'Menu', copied: 'Link copied', noClipboard: 'Copy the link from the address bar',
  },
  es: {
    home: 'Inicio', wisdom: 'Sabiduría', library: 'Biblioteca', graph: 'Grafo', oracle: 'Oráculo', docs: 'Docs',
    signIn: 'Entrar', account: 'Cuenta', main: 'Navegación principal', utility: 'Tu cuenta e idioma',
    skip: 'Saltar al contenido', switchTo: 'English',
    menu: 'Menú', copied: 'Enlace copiado', noClipboard: 'Copia el enlace de la barra de direcciones',
  },
}[lang];

// Toda vista lleva descripción: sin ella el buscador y el compartir se inventan el resumen.
const descripcionPorDefecto = lang === 'es'
  ? 'TTOD, El Tao del Desarrollo: una base de datos de sabiduría pedagógica con citas gobernadas, su fuente y su nivel.'
  : 'TTOD, The Tao of Development: a pedagogical wisdom database of governed quotes, each with its source and level.';
const descripcion = description ?? descripcionPorDefecto;

const otherLocale = lang === 'en' ? 'es' : 'en';
const mismaRutaEnLaOtra = '/' + otherLocale + Astro.url.pathname.replace(/^\/(en|es)/, '');
const switchPath = cambioIdioma ?? mismaRutaEnLaOtra;

// Buscadores y compartir (AA4, F15). El aula entera ya va con `X-Robots-Tag: noindex` desde Caddy
// (AA0 D7 (a)); esto es lo que la página dice de sí misma. Una página que no es un 200, que pide
// sesión o que su fila del registro deja fuera lleva `noindex`, y entonces ni canónica ni alternas:
// no se señala como versión preferida algo que se pide no indexar.
const sePuedeIndexar = indexar !== false && indexable(Astro.url, Astro.response.status);
// Sin un origen de fiar (un host que Astro no conoce), direcciones relativas a la raíz.
const origen = origenPublico(Astro.url, Astro.request.headers);
const urlCanonica = canonica(Astro.url, origen);
const listaAlternas = sePuedeIndexar ? alternas(Astro.url, origen, lang, alterna === undefined ? mismaRutaEnLaOtra : alterna) : [];
const ogLocale = { en: 'en_US', es: 'es_ES' } as const;

// Cuatro destinos (F56). «Inicio» es la marca; en el panel del móvil vuelve como fila.
const links: Array<{ href: string; label: string }> = [
  { href: `/${lang}/wisdom/`, label: nav.wisdom },
  { href: `/${lang}/graph/`, label: nav.graph },
  { href: `/${lang}/oracle/`, label: nav.oracle },
  { href: `/${lang}/docs/`, label: nav.docs },
];
const aqui = Astro.url.pathname;
const entrar = enlaceEntrar(lang, Astro.url);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#fbf8f1" />
    <meta name="description" content={descripcion} />
    {!sePuedeIndexar && <meta name="robots" content="noindex" />}
    {sePuedeIndexar && <link rel="canonical" href={urlCanonica} />}
    {listaAlternas.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta property="og:site_name" content="TTOD" />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={descripcion} />
    {sePuedeIndexar && origen && <meta property="og:url" content={urlCanonica} />}
    <meta property="og:locale" content={ogLocale[lang]} />
    {listaAlternas.length > 0 && <meta property="og:locale:alternate" content={ogLocale[otherLocale]} />}
    {origen && <meta property="og:image" content={`${origen}/visual-system/icon-512.png`} />}
    <meta name="twitter:card" content="summary" />

    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/visual-system/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/visual-system/fonts/Erode-Light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/visual-system/fonts/Gambetta-Light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/visual-system/fonts/Switzer-Variable.woff2" as="font" type="font/woff2" crossorigin />
    {/* Gambetta Regular es la letra del texto corrido de todas las vistas y no
        estaba precargada: se descubría al leer el CSS y llegaba después del primer
        pintado, así que el texto se recolocaba al cambiar de letra (en /docs a 390
        empujaba el pie: CLS 0,154 en Lighthouse móvil). */}
    <link rel="preload" href="/visual-system/fonts/Gambetta-Regular.woff2" as="font" type="font/woff2" crossorigin />
    {fuentesExtra.map((f) => <link rel="preload" href={`/visual-system/fonts/${f}`} as="font" type="font/woff2" crossorigin />)}
    <link rel="stylesheet" href="/visual-system/tokens.css" />
    <link rel="stylesheet" href="/visual-system/backgrounds.css" />

    <title>{title}</title>
    <style>
      :root { color-scheme: light; font-family: var(--ttod-font-body); --ttod-header-height: 3.5rem; }
      /* Todo salto a un fragmento se para debajo de la cabecera (WCAG 2.2, 2.4.11), con una
         sola regla para todas las vistas (LOCATORS §6). La altura es la de la barra (AA3, F56). */
      html { scroll-padding-top: calc(var(--ttod-header-height) + 1rem); }
      .ttod-aviso { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      body {
        margin: 0;
        color: var(--ttod-color-ink);
        background-color: var(--ttod-color-paper);
        font-size: var(--ttod-text-base);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      .ttod-skip-link {
        position: absolute; left: -999px; top: 0; z-index: 40;
        padding: 0.5rem 1rem; background: var(--ttod-color-ink); color: var(--ttod-color-paper);
      }
      .ttod-skip-link:focus { left: 0.5rem; top: 0.5rem; }

      /* --- Cabecera (AA3, F56): la barra clásica de los sistemas de diseño públicos
         y editoriales (GOV.UK *Service navigation*), porque quien lee ya la conoce.
         A todo lo ancho, papel sólido y un filete abajo; sin radio ni sombra
         flotante. Su alto es un token (`--ttod-header-height`) y viene del
         servidor, así que no hay salto al cargar. Debajo de ella el fondo de cada
         vista ya no asoma: la sombra de 61 px que lo pintaba sobra. --- */
      .ttod-site-header {
        position: sticky; top: 0; z-index: 30;
        box-sizing: border-box; min-height: var(--ttod-header-height);
        background: var(--ttod-color-paper);
        border-bottom: 1px solid var(--ttod-color-line-subtle);
        font-family: var(--ttod-font-ui);
        transition: box-shadow .3s ease, transform .3s cubic-bezier(.2, .7, .3, 1);
      }
      .ttod-site-header[data-scrolled] { box-shadow: 0 8px 20px -16px rgb(27 23 16 / .5); }
      .ttod-header-row {
        box-sizing: border-box; display: flex; flex-wrap: wrap; align-items: center;
        gap: 0 clamp(1rem, 2.5vw, 2rem);
        max-width: var(--ttod-max-content, 74rem); margin-inline: auto;
        min-height: calc(var(--ttod-header-height) - 1px);
        padding-inline: clamp(1rem, 3vw, 1.5rem);
      }
      @media (prefers-reduced-motion: reduce) {
        .ttod-site-header { transition: none; }
      }
      .ttod-site-header a { color: inherit; text-decoration: none; }

      /* Todo lo que se toca mide 44 px de alto. */
      .ttod-brand { display: flex; align-items: center; gap: var(--ttod-space-2); min-height: 44px; margin-inline-end: auto; }
      .ttod-brand-mark { font-family: var(--ttod-font-body); font-size: 1.4rem; line-height: 1; color: var(--ttod-color-seal); }
      .ttod-brand-word { font-size: var(--ttod-text-ui); letter-spacing: var(--ttod-tracking-ui); text-transform: uppercase; font-weight: 500; }

      .ttod-panel { display: flex; align-items: center; gap: clamp(1rem, 2.5vw, 2rem); }
      .ttod-site-nav { display: flex; gap: clamp(.9rem, 2vw, 1.75rem); }
      .ttod-site-nav a, .ttod-utility a {
        position: relative; display: inline-flex; align-items: center; min-height: 44px;
        font-size: .9375rem; font-weight: 500; color: #4b4232;
        transition: color .2s ease;
      }
      .ttod-site-nav a:hover, .ttod-utility a:hover { color: var(--ttod-color-ink); }
      /* La página actual: subrayado de sello de 2 px (y `aria-current`, F38). */
      .ttod-site-nav a[aria-current="page"], .ttod-utility a[aria-current="page"] { color: var(--ttod-color-ink); }
      .ttod-site-nav a[aria-current="page"]::after, .ttod-utility a[aria-current="page"]::after {
        content: ""; position: absolute; inset-inline: 0; bottom: .55rem; height: 2px; background: var(--ttod-color-seal);
      }
      /* «Inicio» solo en el panel del móvil; en la barra lo es la marca. Con el mismo peso que la
         regla de los enlaces de arriba, o esta pierde y vuelve a salir. */
      .ttod-site-nav a.ttod-solo-panel { display: none; }
      .ttod-utility {
        display: flex; align-items: center; gap: clamp(.8rem, 1.6vw, 1.25rem);
        padding-inline-start: clamp(.8rem, 1.6vw, 1.25rem);
        border-inline-start: 1px solid var(--ttod-color-line-subtle);
      }
      /* El nombre se recorta dentro de su `span`; el enlace se alinea como sus vecinos (F5). */
      .ttod-cuenta-nombre { max-width: 12ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .ttod-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      /* La lengua, en voz baja: un código de dos letras, nunca una pastilla de tinta. */
      .ttod-lang-switch {
        display: inline-flex; align-items: center; min-height: 44px; padding-inline: .75rem; margin-inline: -.75rem;
        font-size: .8125rem !important; letter-spacing: .08em; font-weight: 500;
        color: var(--ttod-color-muted) !important; background: transparent;
      }
      .ttod-lang-switch:hover { color: var(--ttod-color-ink) !important; text-decoration: underline; text-underline-offset: 4px; }

      .ttod-nav-toggle {
        display: none; align-items: center; gap: .5rem; min-height: 44px;
        padding: .3rem .85rem; border: 1px solid var(--ttod-color-line-subtle); border-radius: .375rem;
        background: transparent; color: inherit; font: inherit; font-size: .9375rem; font-weight: 500; cursor: pointer;
      }

      /* El estado de red solo habla cuando hay algo que decir (región viva siempre). */
      #ttod-network-boundary {
        margin: 0; font-family: var(--ttod-font-ui);
        font-size: var(--ttod-text-ui); letter-spacing: .14em; text-transform: uppercase;
        font-weight: 500; color: var(--ttod-color-seal);
      }
      #ttod-network-boundary:not([data-state='offline']) {
        position: absolute; left: -9999px; top: 0; width: auto; height: auto;
        overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
      }
      #ttod-network-boundary[data-state='offline'] { display: inline-flex; align-items: center; min-height: 44px; }
      #ttod-network-boundary[data-state='offline']::before {
        content: ""; display: inline-block; width: .4rem; height: .4rem; margin-inline-end: .4rem;
        border-radius: 50%; background: currentColor;
      }

      /* Al bajar, la barra se aparta en el móvil (y vuelve al subir, con el tabulador o
         con el foco dentro; con el menú abierto no se va). Con «reducir movimiento» no se
         aparta nunca (cold review AA3, F3): antes una regla más específica le devolvía la
         transición. Un salto a un fragmento hacia abajo la deja apartada: es lo previsto
         (vuelve al subir), y el fragmento queda arriba, a la vista. */
      @media (max-width: 39.99rem) and (prefers-reduced-motion: no-preference) {
        .ttod-site-header[data-oculta]:not([data-open]):not(:focus-within) {
          transform: translateY(-100%); visibility: hidden;
          transition: transform .3s cubic-bezier(.2, .7, .3, 1), visibility 0s .3s;
        }
      }

      /* Por debajo de 40rem: marca y «Menú». El menú es una navegación desplegable
         (WAI-ARIA APG *Disclosure Navigation*): el panel se abre debajo de la barra
         y empuja el contenido, filas de 48 px. No es modal, así que no atrapa el foco. */
      @media (max-width: 39.99rem) {
        .ttod-site-header[data-collapsible] .ttod-nav-toggle { display: inline-flex; }
        .ttod-site-header[data-collapsible] .ttod-panel {
          display: none; flex-basis: 100%; flex-direction: column; align-items: stretch; gap: 0;
          padding-block: 0 .75rem;
        }
        .ttod-site-header[data-collapsible][data-open] .ttod-panel { display: flex; }
        .ttod-site-header[data-collapsible] .ttod-site-nav,
        .ttod-site-header[data-collapsible] .ttod-utility { flex-direction: column; align-items: stretch; gap: 0; padding: 0; border: 0; }
        .ttod-site-header[data-collapsible] .ttod-panel a {
          min-height: 48px; border-top: 1px solid var(--ttod-color-line-subtle); font-size: 1rem;
        }
        .ttod-site-header[data-collapsible] .ttod-panel a[aria-current="page"]::after { bottom: .7rem; inset-inline-end: auto; width: 2.5rem; }
        .ttod-site-header[data-collapsible] .ttod-site-nav a.ttod-solo-panel { display: inline-flex; }
        .ttod-site-header[data-collapsible] .ttod-cuenta-nombre { max-width: none; }
        .ttod-site-header[data-collapsible] .ttod-lang-switch { margin-inline: 0; padding-inline: 0; }
        #ttod-network-boundary[data-state='offline'] { font-size: .75rem; letter-spacing: .04em; }
      }

    </style>
    <!-- Sin JS no hay botón que despliegue nada, así que la navegación se queda
         a la vista: es la excepción, y aquí la paga solo quien la necesita.
         Antes era al revés —el guion ponía `data-collapsible` al arrancar— y a
         390 px eso significaba pintar la barra entera (223 px) hasta los 3,8 s
         y plegarla de golpe a 61: un tirón de 155 px en plena lectura, medido
         en 0,19 de CLS en todas las vistas. -->
    <noscript><style>
      @media (max-width: 39.99rem) {
        .ttod-site-header[data-collapsible] .ttod-panel { display: flex; }
        .ttod-site-header[data-collapsible] .ttod-nav-toggle { display: none; }
      }
    </style></noscript>
  </head>
  <body class="ttod-bg-river">
    <a class="ttod-skip-link" href="#ttod-main">{nav.skip}</a>
    <header class="ttod-site-header" id="ttod-site-header" data-collapsible>
      <div class="ttod-header-row">
        <a class="ttod-brand" href={`/${lang}/`} aria-label={`TTOD · ${nav.home}`}>
          <span class="ttod-brand-mark" aria-hidden="true">道</span>
          <span class="ttod-brand-word" aria-hidden="true">TTOD</span>
        </a>
        <p
          id="ttod-network-boundary"
          class="ttod-sr-only-cuando-online"
          role="status"
          aria-live="polite"
          aria-atomic="true"
          data-state="unknown"
          data-online-label={lang === 'es' ? 'En línea' : 'Online'}
          data-offline-label={lang === 'es' ? 'Sin conexión' : 'Offline'}
        >
          {lang === 'es' ? 'Comprobando conexión…' : 'Checking connection…'}
        </p>
        <button class="ttod-nav-toggle" type="button" aria-expanded="false" aria-controls="ttod-site-panel">{nav.menu}</button>
        <div class="ttod-panel" id="ttod-site-panel">
          <nav class="ttod-site-nav" id="ttod-site-nav" aria-label={nav.main}>
            <a class="ttod-solo-panel" href={`/${lang}/`} aria-current={aqui === `/${lang}/` ? 'page' : undefined}>{nav.home}</a>
            {links.map((link) => (
              <a href={link.href} aria-current={esActual(aqui, link.href) ? 'page' : undefined}>{link.label}</a>
            ))}
          </nav>
          <div class="ttod-utility" role="group" aria-label={nav.utility}>
            {usuario && <a href={`/${lang}/library/`} aria-current={esActual(aqui, `/${lang}/library/`) ? 'page' : undefined}>{nav.library}</a>}
            {usuario
              ? <a class="ttod-cuenta" href={`/${lang}/account/`} aria-current={esActual(aqui, `/${lang}/account/`) ? 'page' : undefined}>
                  {/* El nombre accesible dice qué es el enlace y conserva el texto visible (WCAG 2.4.4, 2.5.3).
                      Sin `title`: sin nombre de usuario mostraba el correo a quien mirase la pantalla. */}
                  {usuario.display_name ? <><span class="ttod-sr">{nav.account}: </span><span class="ttod-cuenta-nombre">{usuario.display_name}</span></> : nav.account}
                </a>
              : <a href={entrar}>{nav.signIn}</a>}
            <a class="ttod-lang-switch" href={switchPath} hreflang={otherLocale} lang={otherLocale} data-cambio-idioma aria-label={`${nav.switchTo} (${otherLocale.toUpperCase()})`}>{otherLocale.toUpperCase()}</a>
          </div>
        </div>
      </div>
    </header>
    <slot />
    <Footer lang={lang} switchPath={switchPath} usuario={usuario} />
    <p id="ttod-aviso" class="ttod-aviso" role="status" aria-live="polite" data-copiado={nav.copied} data-sin-portapapeles={nav.noClipboard}></p>
    <script>
      const boundary = document.getElementById('ttod-network-boundary');

      if (boundary) {
        const updateNetworkState = () => {
          const online = navigator.onLine;

          boundary.dataset.state = online ? 'online' : 'offline';
          boundary.textContent = online
            ? boundary.dataset.onlineLabel ?? 'Online'
            : boundary.dataset.offlineLabel ?? 'Offline';
        };

        updateNetworkState();

        window.addEventListener('online', updateNetworkState);
        window.addEventListener('offline', updateNetworkState);
      }

      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch((error) => {
          console.error('Service worker registration failed:', error);
        });
      }
    </script>
    <script>
      // Enlaces que se completan en el navegador (AA3b): el cambio de idioma lleva
      // `search + hash`, y «copiar enlace» copia la dirección absoluta y lo anuncia.
      import { enlazarCambioIdioma } from '../lib/idioma';
      import { enlazarCopiarEnlace } from '../lib/copiarEnlace';
      import { enlazarIgualQue, enlazarVerContrasena } from '../lib/campos-clave';
      enlazarCambioIdioma();
      enlazarCopiarEnlace();
      // Mostrar u ocultar contraseñas, y «repite la contraseña» que avisa si no coincide:
      // un solo sitio para la cuenta, el registro y la entrada (AA3, F55/F36).
      enlazarVerContrasena();
      enlazarIgualQue();

      const header = document.getElementById('ttod-site-header');
      const toggle = header?.querySelector<HTMLButtonElement>('.ttod-nav-toggle');

      if (header && toggle) {
        // `data-collapsible` ya viene en el HTML del servidor (y el caso sin JS
        // lo cubre el `<noscript>` del `<head>`): la barra nace plegada y no hay
        // nada que recolocar cuando este guion arranca.

        // Todo lo que se abre se cierra por las tres vías: el propio botón,
        // Escape y tocando fuera.
        const abierto = () => header.hasAttribute('data-open');
        const cerrar = (devolverFoco: boolean) => {
          if (!abierto()) return;
          header.removeAttribute('data-open');
          toggle.setAttribute('aria-expanded', 'false');
          // Con Escape el foco vuelve al botón: quien cerró con el teclado
          // tiene que seguir desde donde estaba, no desde el principio.
          if (devolverFoco) toggle.focus();
        };
        const abrir = () => {
          header.dataset.open = '';
          toggle.setAttribute('aria-expanded', 'true');
        };
        toggle.addEventListener('click', () => (abierto() ? cerrar(false) : abrir()));

        // Navegación desplegable, no un diálogo (AA3, F56): el tabulador sigue
        // su camino hacia la página. Escape cierra y devuelve el foco al botón.
        document.addEventListener('keydown', (ev) => {
          if (abierto() && ev.key === 'Escape') cerrar(true);
        });

        // Con el dedo y con el ratón: `pointerdown` para que cierre al tocar,
        // no al soltar.
        document.addEventListener('pointerdown', (ev) => {
          if (!abierto()) return;
          const destino = ev.target;
          if (destino instanceof Node && header.contains(destino)) return;
          cerrar(false);
        });
      }

      if (header) {
        let anterior = window.scrollY;
        const onScroll = () => {
          const y = window.scrollY;
          if (y > 24) header.dataset.scrolled = '';
          else header.removeAttribute('data-scrolled');

          // Umbral de 6 px: el rebote del scroll en móvil no debe hacerla parpadear.
          if (y > 200 && y > anterior + 6) header.dataset.oculta = '';
          else if (y < anterior - 6 || y <= 200) header.removeAttribute('data-oculta');
          anterior = y;
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
        // Apartada no puede significar inalcanzable: al primer tabulador la
        // barra vuelve, y el foco entra en ella como en cualquier página.
        window.addEventListener('keydown', (ev) => {
          if (ev.key === 'Tab') header.removeAttribute('data-oculta');
        });
      }
    </script>
  </body>
