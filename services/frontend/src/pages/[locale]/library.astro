---
import Page from '../../layouts/Page.astro';
import FavoriteButton from '../../components/favorites/FavoriteButton';
import { SESSION_COOKIE_NAME, requireUser } from '../../lib/auth.server';
import { isLocale } from '../../content/wisdom';
import type { FavoriteEntry, WisdomEntry } from '../../types/domain';

export const prerender = false;

const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const authenticatedUser = await requireUser(Astro.request);
if (authenticatedUser instanceof Response) return authenticatedUser;

const backend = import.meta.env.BACKEND_URL ?? 'http://backend:8000';
// Al backend solo se reenvía la cookie de sesión, no el resto de cabeceras del navegador.
const sessionCookie = `${SESSION_COOKIE_NAME}=${Astro.cookies.get(SESSION_COOKIE_NAME)?.value ?? ''}`;

async function getJson<T>(path: string, headers: Record<string, string>): Promise<T | null> {
  try {
    const response = await fetch(`${backend}${path}`, { headers: { accept: 'application/json', ...headers } });
    return response.ok ? await response.json() as T : null;
  } catch (error) {
    console.error(`Unable to load ${path} for the personal library.`, error);
    return null;
  }
}

const [favorites, wisdom] = await Promise.all([
  getJson<FavoriteEntry[]>('/api/v1/favorites', { cookie: sessionCookie }),
  getJson<WisdomEntry[]>('/api/v1/wisdom/sample', {}),
]);
// Si falla cualquiera de las dos peticiones no se sabe qué hay guardado: decir
// «todavía no has guardado citas» sería mentir. Se avisa del fallo con un 503.
const failed = favorites === null || wisdom === null;
if (failed) Astro.response.status = 503;

const quotes = failed ? [] : favorites
  .map((favorite) => ({ favorite, quote: wisdom.find((entry) => entry.id === favorite.quoteId) }))
  .filter((entry): entry is { favorite: FavoriteEntry; quote: WisdomEntry } => Boolean(entry.quote));

const dateFormat = new Intl.DateTimeFormat(locale === 'es' ? 'es-ES' : 'en-GB', { dateStyle: 'long', timeZone: 'UTC' });
const savedOn = (savedAt: string) => {
  const date = new Date(savedAt);
  return Number.isNaN(date.getTime()) ? null : { iso: date.toISOString(), text: dateFormat.format(date) };
};

const copy = locale === 'es'
  ? {
      title: 'Mi biblioteca', description: 'Las citas que has guardado en TTOD.',
      empty: 'Todavía no has guardado citas.', browse: 'Explorar la sabiduría', saved: 'Guardada el',
      failed: 'No se ha podido cargar tu biblioteca porque el servicio no responde. Tus citas siguen guardadas: vuelve a intentarlo en un momento.'
    }
  : {
      title: 'My library', description: 'The quotes you have saved in TTOD.',
      empty: 'You have not saved any quotes yet.', browse: 'Browse the wisdom', saved: 'Saved on',
      failed: 'Your library could not be loaded because the service is not answering. Your quotes are still saved: please try again in a moment.'
    };
---
<Page lang={locale} title={copy.title} description={copy.description}>
  <style>
    button { transition: opacity 160ms ease; }
    @media (prefers-reduced-motion: reduce) {
      button { transition: none; }
    }
  </style>
  <main>
    <h1>{copy.title}</h1>
    {failed ? <p role="alert">{copy.failed}</p>
      : quotes.length === 0 ? <p>{copy.empty} <a href={`/${locale}/wisdom/`}>{copy.browse}</a></p>
      : <section aria-label={copy.title}>
      {quotes.map(({ favorite, quote }) => {
        const date = savedOn(favorite.savedAt);
        return <article>
          <blockquote>{quote.text}</blockquote>
          <p class="meta">
            <a href={`/${locale}/wisdom/${quote.id}/`}>{quote.id}</a> · {quote.section}
            {date && <> · {copy.saved} <time datetime={date.iso}>{date.text}</time></>}
          </p>
          <FavoriteButton client:load quoteId={quote.id} locale={locale} />
        </article>;
      })}
    </section>}
  </main>
</Page>
