---
import Page from '../../../../layouts/Page.astro';
import ProvenanceBlock from '../../../../components/ProvenanceBlock.astro';
import { fetchWisdom, isLocale, labels } from '../../../../content/wisdom';
import '../../../../styles/tokens.css';
const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });
const entries = (await fetchWisdom(locale)).filter((entry) => entry.level === Astro.params.level);
const copy = labels[locale];
---
<Page lang={locale} title={`${copy.levels}: ${Astro.params.level}`}><main class="ttod-shell"><nav class="ttod-nav"><a href={`/${locale}/wisdom/`}>← {copy.back}</a></nav><h1>{copy.levels}: {Astro.params.level}</h1>{entries.length === 0 ? <p class="ttod-empty">{copy.empty}</p> : <div class="ttod-grid">{entries.map((entry) => <article class="ttod-card"><blockquote>{entry.text}</blockquote><a href={`/${locale}/wisdom/${entry.id}/`}>{entry.id}</a><ProvenanceBlock entry={entry} locale={locale} variant="compact" /></article>)}</div>}</main></Page>
