---
import Page from '../../../../layouts/Page.astro';
import EmptyState from '../../../../components/EmptyState.astro';
import { fetchWisdom, frequencies, isLocale, labels } from '../../../../content/wisdom';
import '../../../../styles/tokens.css';
const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });
const all = await fetchWisdom(locale);
const entries = all.filter((entry) => entry.section === Astro.params.section);
const siblings = frequencies(all, 'section');
const copy = labels[locale];
---
<Page lang={locale} title={`${copy.sections}: ${Astro.params.section}`}>
  <main class="ttod-shell">
    <nav class="ttod-nav"><a href={`/${locale}/wisdom/`}>← {copy.back}</a></nav>
    <h1>{copy.sections}: {Astro.params.section}</h1>
    <nav class="ttod-clusters" aria-label={copy.sections}>{siblings.map(([value, count]) => <a class="ttod-pill" href={`/${locale}/wisdom/sections/${value}/`} aria-current={value === Astro.params.section ? 'page' : undefined}>{value} ({count})</a>)}</nav>
    {entries.length === 0 ? <EmptyState title={copy.noMatchesTitle} message={copy.noMatches} action={{ label: copy.back, href: `/${locale}/wisdom/` }} /> : <div class="ttod-grid">{entries.map((entry) => <article class="ttod-card"><blockquote>{entry.text}</blockquote><a href={`/${locale}/wisdom/${entry.id}/`}>{entry.id}</a><footer class="ttod-meta">{entry.rights.holder ?? 'Rubén Vega Balbás'} · {entry.rights.license}</footer></article>)}</div>}
  </main>
</Page>
