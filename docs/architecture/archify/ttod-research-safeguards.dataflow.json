        "id": "gated-sources",
        "label": "Nothing flows without consent",
        "focus": ["sources", "gate"],
        "note": "Telemetry, coursework, and oral explanation stay candidate evidence until consent and ethics/data review clear them."
      },
      {
        "id": "separated-datasets",
        "label": "Distinct datasets, triangulated",
        "focus": ["gate", "datasets", "triangulation", "validated", "mixed"],
        "note": "Teaching and research datasets never share an identity. Validated and negative/mixed findings are equally valid outputs."
      }
    ]
  },
  "stages": [
    { "label": "Candidate" },
    { "label": "Gate" },
    { "label": "Separated" },
    { "label": "Triangulate" },
    { "label": "Findings" }
